diff --git tensorfold/cuda/dflash_compat.py tensorfold/cuda/dflash_compat.py
index 2331e1b..f0f8476 100644
--- tensorfold/cuda/dflash_compat.py
+++ tensorfold/cuda/dflash_compat.py
@@ -1,9 +1,11 @@
 """DFlash2 drafters beyond the reference one, without a GPU import: the attention window of a full-attention drafter
-(TF_GLM_DFLASH_WINDOW) and the drafter-shipped copies of the target's embedding and head, which are never loaded."""
+(TF_GLM_DFLASH_WINDOW), a learned mask embedding shipped as mask_embedding.pt, and the drafter-shipped copies of the
+target's embedding and head, which are never loaded."""
 
 from __future__ import annotations
 
 import os
+from pathlib import Path
 
 DEFAULT_WINDOW = 2048            # tokens of context a full-attention drafter attends to unless TF_GLM_DFLASH_WINDOW says
 MIN_WINDOW = 64                  # one attention tile
@@ -27,3 +29,61 @@ def dflash_window(cfg: dict) -> int:
     if window != 0 and window < MIN_WINDOW:
         raise ValueError(f"TF_GLM_DFLASH_WINDOW is 0 (full attention) or at least {MIN_WINDOW} tokens, not {window}")
     return window
+
+
+MASK_FILE = "mask_embedding.pt"
+SAMPLE_ROWS = (0, 1, 1000, 50000, 100000, 154856)      # rows compared with the target's (and the table's last)
+
+
+def load_mask_embedding(draft_dir, mask_id: int, hidden: int):
+    """The drafter's own embedding for its mask token, bf16 [hidden] on the CPU, or None without mask_embedding.pt.
+    The file holds {"mask_token_id": id, "embedding": tensor} or the tensor alone (vLLM's DFlash loader's format)."""
+
+    path = Path(draft_dir) / MASK_FILE
+    if not path.exists():
+        return None
+    import torch
+
+    state = torch.load(path, map_location="cpu", weights_only=True)
+    if isinstance(state, dict):
+        if int(state.get("mask_token_id", mask_id)) != mask_id:
+            raise ValueError(f"{MASK_FILE}'s mask_token_id {state.get('mask_token_id')} is not the drafter's {mask_id}")
+        if "embedding" not in state:
+            raise ValueError(f"{MASK_FILE} holds no 'embedding'")
+        state = state["embedding"]
+    if not isinstance(state, torch.Tensor) or state.numel() != hidden:
+        raise ValueError(f"{MASK_FILE} must hold {hidden} values (the drafter's hidden size)")
+    return state.reshape(hidden).to(torch.bfloat16).contiguous()
+
+
+def apply_mask_embedding(x, ids, mask_id: int, vec):
+    """Rows of ``x`` whose id is the mask token take ``vec`` (fixed shapes: safe inside a CUDA graph)."""
+
+    import torch
+
+    return torch.where((ids == mask_id).unsqueeze(1), vec.to(x.dtype), x)
+
+
+def check_owned_embedding(draft_dir, target_embed, rows=SAMPLE_ROWS) -> str:
+    """A drafter that ships embed_tokens must ship the target's (the target's are what drafts use): sampled rows are
+    compared with the target's BF16 table and a difference is refused. Returns a line for the log, "" when the drafter
+    ships no embedding."""
+
+    import torch
+    from safetensors import safe_open
+
+    with safe_open(str(Path(draft_dir) / "model.safetensors"), framework="pt", device="cpu") as f:
+        if "embed_tokens.weight" not in f.keys():
+            return ""
+        if not isinstance(target_embed, torch.Tensor):
+            return ("the drafter's embed_tokens were not compared (the target's embedding is quantized); the target's "
+                    "embedding and head are used")
+        table = f.get_slice("embed_tokens.weight")
+        vocab = table.get_shape()[0]
+        for r in sorted({r for r in rows if r < vocab} | {vocab - 1}):
+            mine = table[r:r + 1].to(torch.bfloat16)
+            theirs = target_embed[r:r + 1].to("cpu", torch.bfloat16)
+            if mine.shape != theirs.shape or not torch.equal(mine, theirs):
+                raise ValueError(f"the drafter's embed_tokens differ from the target's (row {r}): drafter-owned "
+                                 "embeddings and heads are not supported")
+    return "the drafter's embed_tokens equal the target's (sampled rows): the target's embedding and head are used"
