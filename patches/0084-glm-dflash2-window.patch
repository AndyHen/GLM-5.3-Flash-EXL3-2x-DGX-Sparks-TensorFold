new file mode 100644
index 0000000..2331e1b
--- /dev/null
+++ tensorfold/cuda/dflash_compat.py
@@ -0,0 +1,29 @@
+"""DFlash2 drafters beyond the reference one, without a GPU import: the attention window of a full-attention drafter
+(TF_GLM_DFLASH_WINDOW) and the drafter-shipped copies of the target's embedding and head, which are never loaded."""
+
+from __future__ import annotations
+
+import os
+
+DEFAULT_WINDOW = 2048            # tokens of context a full-attention drafter attends to unless TF_GLM_DFLASH_WINDOW says
+MIN_WINDOW = 64                  # one attention tile
+OWNED = ("embed_tokens.weight", "lm_head.weight")    # copies of the target's: the target's own are used
+
+
+def dflash_window(cfg: dict) -> int:
+    """The drafter's context window in tokens: the config's ``sliding_window`` when it has one, else
+    TF_GLM_DFLASH_WINDOW (default 2048); 0 means full attention (every committed row, a flat context)."""
+
+    own = cfg.get("sliding_window")
+    if own is not None and int(own) > 0:
+        return int(own)
+    raw = os.environ.get("TF_GLM_DFLASH_WINDOW", "").strip()
+    if not raw:
+        return DEFAULT_WINDOW
+    try:
+        window = int(raw)
+    except ValueError:
+        raise ValueError(f"TF_GLM_DFLASH_WINDOW is a token count (0: full attention), not {raw!r}") from None
+    if window != 0 and window < MIN_WINDOW:
+        raise ValueError(f"TF_GLM_DFLASH_WINDOW is 0 (full attention) or at least {MIN_WINDOW} tokens, not {window}")
+    return window
